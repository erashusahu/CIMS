# The runtime DB role must be a non-owner and must not have BYPASSRLS.
DATABASE_URL=postgresql+asyncpg://cims_app:change-me@localhost:5432/cims
MIGRATION_DATABASE_URL=postgresql+asyncpg://cims_migrator:change-me@localhost:5432/cims
JWT_SECRET=replace-with-at-least-32-random-bytes
FRONTEND_ORIGIN=http://127.0.0.1:5174
COOKIE_SECURE=false
ACCESS_TOKEN_MINUTES=15
SESSION_DAYS=7
APP_ENV=development
# Optional temporary catalog workspace; allowed only on this computer in development.
CATALOG_LOCAL_MODE=false
